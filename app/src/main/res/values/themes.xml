<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Respiro" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/fg</item>
        <item name="android:colorAccent">@color/fg</item>
        <item name="android:colorControlActivated">@color/fg</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:alertDialogTheme">@style/Respiro.Dialog</item>
    </style>
    <style name="Respiro.Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/fg</item>
        <item name="android:colorControlActivated">@color/fg</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:buttonBarButtonStyle">@style/Respiro.DialogButton</item>
    </style>
    <style name="Respiro.DialogButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/dialog_button</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
